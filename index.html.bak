79_01.jpg", "/images_branded/1339367579_02.jpg", "/images_branded/1339367579_03.jpg"], "1186703715": ["/images_branded/1186703715_01.jpg", "/images_branded/1186703715_02.jpg", "/images_branded/1186703715_03.jpg"], "1327671708": ["/images_branded/1327671708_01.jpg", "/images_branded/1327671708_02.jpg", "/images_branded/1327671708_03.jpg"], "1328978638": ["/images_branded/1328978638_01.jpg", "/images_branded/1328978638_02.jpg", "/images_branded/1328978638_03.jpg"], "1341637295": ["/images_branded/1341637295_01.jpg", "/images_branded/1341637295_02.jpg", "/images_branded/1341637295_03.jpg"], "1343763223": ["/images_branded/1343763223_01.jpg", "/images_branded/1343763223_02.jpg", "/images_branded/1343763223_03.jpg"], "1303618539": ["/images_branded/1303618539_01.jpg", "/images_branded/1303618539_02.jpg", "/images_branded/1303618539_03.jpg"], "1339273400": ["/images_branded/1339273400_01.jpg", "/images_branded/1339273400_02.jpg", "/images_branded/1339273400_03.jpg"], "1343732005": ["/images_branded/1343732005_01.jpg", "/images_branded/1343732005_02.jpg", "/images_branded/1343732005_03.jpg"], "1326366637": ["/images_branded/1326366637_01.jpg", "/images_branded/1326366637_02.jpg", "/images_branded/1326366637_03.jpg"], "1260811982": ["/images_branded/1260811982_01.jpg", "/images_branded/1260811982_02.jpg", "/images_branded/1260811982_03.jpg"], "1315614384": ["/images_branded/1315614384_01.jpg", "/images_branded/1315614384_02.jpg", "/images_branded/1315614384_03.jpg"], "1327778999": ["/images_branded/1327778999_01.jpg", "/images_branded/1327778999_02.jpg", "/images_branded/1327778999_03.jpg"], "1298192591": ["/images_branded/1298192591_01.jpg", "/images_branded/1298192591_02.jpg", "/images_branded/1298192591_03.jpg"], "1335782084": ["/images_branded/1335782084_01.jpg", "/images_branded/1335782084_02.jpg", "/images_branded/1335782084_03.jpg"], "1323923570": ["/images_branded/1323923570_01.jpg", "/images_branded/1323923570_02.jpg", "/images_branded/1323923570_03.jpg"], "1332448795": ["/images_branded/1332448795_01.jpg", "/images_branded/1332448795_02.jpg", "/images_branded/1332448795_03.jpg"], "1337740642": ["/images_branded/1337740642_01.jpg", "/images_branded/1337740642_02.jpg", "/images_branded/1337740642_03.jpg"], "1330012151": ["/images_branded/1330012151_01.jpg", "/images_branded/1330012151_02.jpg", "/images_branded/1330012151_03.jpg"], "1330207193": ["/images_branded/1330207193_01.jpg", "/images_branded/1330207193_02.jpg", "/images_branded/1330207193_03.jpg"]}, "logos": {"lockup": "", "mark": ""}}
</script>

<script>
(function(){
  "use strict";
  var PAYLOAD = JSON.parse(document.getElementById('deck-data').textContent);
  var DATA = PAYLOAD.listings;
  var PHOTOS = PAYLOAD.photos || {};
  var LOGOS = PAYLOAD.logos || {};

  function TL(n){ return n.toLocaleString('tr-TR'); }
  function esc(s){
    return String(s).replace(/[&<>"']/g, function(c){
      return {'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c];
    });
  }
  function el(id){ return document.getElementById(id); }

  // logos
  if (LOGOS.lockup) {
    ['logo-header','logo-footer'].forEach(function(id){
      el(id).src = 'data:image/png;base64,' + LOGOS.lockup;
    });
  }

  function getPortal(d){
    if(d.source_platform){
      if(d.source_platform==='sahibinden') return 'sahibinden';
      if(d.source_platform==='hepsiemlak') return 'hepsiemlak';
      return 'trio';
    }
    if(d.url){
      var u=String(d.url).toLowerCase();
      if(u.indexOf('sahibinden.com')>-1) return 'sahibinden';
      if(u.indexOf('hepsiemlak.com')>-1) return 'hepsiemlak';
    }
    return 'trio';
  }

  function initFilters(){
    var rooms = [];
    DATA.forEach(function(d){ if(d.rooms && rooms.indexOf(d.rooms)===-1) rooms.push(d.rooms); });
    rooms.sort();
    var rs = el('f-rooms');
    rooms.forEach(function(v){
      var o = document.createElement('option'); o.value=v; o.textContent=v; rs.appendChild(o);
    });

    var m2s = [];
    DATA.forEach(function(d){ if(d.m2 && m2s.indexOf(d.m2)===-1) m2s.push(d.m2); });
    m2s.sort(function(a,b){return a-b;});
    var ms = el('f-m2');
    m2s.forEach(function(v){
      var o = document.createElement('option'); o.value=v; o.textContent=v+' m² ve üzeri'; ms.appendChild(o);
    });

    var prices = DATA.map(function(d){return d.price;}).filter(Boolean);
    var lo = Math.min.apply(null,prices), hi = Math.max.apply(null,prices);
    var step = 100000;
    var pr = el('f-price');
    pr.min = Math.floor(lo/step)*step; pr.max = Math.ceil(hi/step)*step; pr.step = step;
    pr.value = pr.max;

    ['f-price','f-rooms','f-m2','f-sort','f-sale','f-type','f-neigh','f-portal'].forEach(function(id){
      el(id).addEventListener('input', apply);
    });
    el('f-reset').addEventListener('click', function(){
      el('f-price').value = pr.max;
      el('f-rooms').value = '';
      el('f-m2').value = '';
      el('f-sale').value = '';
      el('f-type').value = '';
      el('f-neigh').value = '';
      el('f-sort').value = 'price-asc';
      el('f-portal').value = '';
      apply();
    });

        // Neighborhood options
    var neighborhoods = [];
    DATA.forEach(function(d){
      var n = (d.location || '').trim();
      if(n && neighborhoods.indexOf(n) === -1) neighborhoods.push(n);
    });
    neighborhoods.sort();
    var nf = el('f-neigh');
    neighborhoods.forEach(function(v){
      var o = document.createElement('option'); o.value = v; o.textContent = v; nf.appendChild(o);
    });

    var m2all = DATA.map(function(d){return d.m2;}).filter(Boolean);
    el('m-total').textContent = DATA.length;
    el('m-min').textContent = TL(Math.min.apply(null,prices));
    el('m-m2').textContent = Math.min.apply(null,m2all)+'–'+Math.max.apply(null,m2all);
  }

  function apply(){
    var maxP = +el('f-price').value;
    var rooms = el('f-rooms').value;
    var minM2 = +el('f-m2').value || 0;
    var sort = el('f-sort').value;
    el('f-price-v').textContent = TL(maxP);

    var saleFilter = el('f-sale').value;
    var typeFilter = el('f-type').value;
    var neighFilter = el('f-neigh').value;
    var portalFilter = el('f-portal').value;

    function deriveSale(title){
      if(!title) return '';
      var t = String(title).toLowerCase();
      if(t.indexOf('kiralık') > -1 || t.indexOf('kiralik') > -1 || t.indexOf('kira') > -1) return 'Kiralık';
      if(t.indexOf('satılık') > -1 || t.indexOf('satilik') > -1 || t.indexOf('satilik') > -1) return 'Satılık';
      return '';
    }
    function deriveType(title){
      if(!title) return '';
      var t = String(title).toLowerCase();
      if(t.indexOf('villa') > -1) return 'Villa';
      if(t.indexOf('ofis') > -1 || t.indexOf('büro') > -1) return 'Ofis / Büro';
      if(t.indexOf('müstakil') > -1 || (t.indexOf('ev') > -1 && t.indexOf('daire') === -1)) return 'Müstakil / Ev';
      if(t.indexOf('daire') > -1) return 'Daire';
      return '';
    }
    var rows = DATA.filter(function(d){
      var ok = (!d.price || d.price <= maxP) &&
             (!rooms || d.rooms === rooms) &&
             (!minM2 || (d.m2||0) >= minM2);
      if(!ok) return false;
      if(saleFilter) {
        var sale = deriveSale(d.title);
        if(sale !== saleFilter) return false;
      }
      if(typeFilter) {
        var t = deriveType(d.title);
        if(t !== typeFilter) return false;
      }
      if(neighFilter) {
        var loc = String(d.location || d.title || '').toLowerCase();
        var nf = neighFilter.toLowerCase();
        if(loc.indexOf(nf) === -1) return false;
      }
      if(portalFilter) {
        if(getPortal(d) !== portalFilter) return false;
      }
      return true;
    });

    var cmp = {
      'price-asc':  function(a,b){return (a.price||0)-(b.price||0);},
      'price-desc': function(a,b){return (b.price||0)-(a.price||0);},
      'm2-desc':    function(a,b){return (b.m2||0)-(a.m2||0);},
      'm2-asc':     function(a,b){return (a.m2||0)-(b.m2||0);},
      'date-desc':  function(a,b){return new Date(b.date)-new Date(a.date);}
    }[sort];
    rows.sort(cmp);

    el('c-n').textContent = rows.length;
    render(rows);
  }

  function render(rows){
    var g = el('grid');
    if(!rows.length){
      g.innerHTML = '<div class="empty"><b>Kriterlere uygun ilan yok</b>'+
        'Filtreleri gevşetmeyi deneyin veya bizimle iletişime geçin.</div>';
      return;
    }
    g.innerHTML = rows.map(function(d){
      var b64arr = PHOTOS[d.id];
      var photoCount = (b64arr && b64arr.length) || 0;
      var photo = (b64arr && b64arr.length)
        ? '<img src="'+(Array.isArray(b64arr[0]) ? b64arr[0][0] : (b64arr[0].indexOf('/')===0 || b64arr[0].indexOf('http')===0 ? b64arr[0] : '/images_branded/'+b64arr[0]))+'" alt="'+esc(d.title)+'" >'
        : '<div class="ph">Fotoğraf yok</div>';
      var counter = photoCount > 1
        ? '<span class="thumb-nav">1/'+photoCount+'</span>'
        : '';
      var portal = getPortal(d);
      var portalBadge = portal==='sahibinden'
        ? '<span class="portal-badge portal-sahibinden" title="Sahibinden.com">S</span>'
        : portal==='hepsiemlak'
        ? '<span class="portal-badge portal-hepsiemlak" title="Hepsiemlak.com">H</span>'
        : '<span class="portal-badge portal-trio" title="Trio Emlak">T</span>';
      return '<div class="card" data-id="'+esc(d.id)+'" role="button" tabindex="0" aria-label="'+esc(d.title)+' detaylarını gör">'+
        '<div class="thumb">'+photo+counter+portalBadge+'<span class="tag">'+esc(d.rooms||'—')+'</span></div>'+
        '<div class="body">'+
          '<div class="title">'+esc(d.title)+'</div>'+
          '<div class="price">'+esc(d.price_text||'Fiyat sorunuz')+'</div>'+'<div class="code-tag">'+esc(d.code||d.id||'')+'</div>'+
          '<div class="specs">'+
            (d.m2?'<span class="chip">'+d.m2+' m²</span>':'')+
            (d.rooms?'<span class="chip">'+esc(d.rooms)+'</span>':'')+
            (d.location?'<span class="chip">'+esc(d.location)+'</span>':'')+
          '</div>'+
          '<div class="foot"><span>'+esc(d.date||'')+'</span><span>'+esc(d.location||'')+'</span></div>'+
        '</div>';
    }).join('');
  }

  // ── detail modal (çoklu fotoğraf galerisi) ──
  var galleryState = { photos: [], current: 0, listingId: null };

  function updateGalleryPhoto() {
    var photos = galleryState.photos;
    var idx = galleryState.current;
    var container = el('dm-photo');
    if (photos.length === 0) {
      container.innerHTML = '<div class="ph">Fotoğraf yok</div>';
      return;
    }
    var imgSrc = (typeof photos[idx] === 'string' && photos[idx].indexOf('http') === -1 && photos[idx].indexOf('/') === 0)
      ? photos[idx]
      : ((Array.isArray(photos[idx]) ? photos[idx][0] : photos[idx]) || '');
    var img = '<img src="' + imgSrc + '" alt="Fotoğraf">';
    var nav = '';
    if (photos.length > 1) {
      var prevIdx = (idx - 1 + photos.length) % photos.length;
      var nextIdx = (idx + 1) % photos.length;
      nav = '<button class="gallery-arrow prev" data-goto="' + prevIdx + '">&#8249;</button>' +
            '<button class="gallery-arrow next" data-goto="' + nextIdx + '">&#8250;</button>';
      var dots = '<div class="gallery-nav">' + photos.map(function(_, i) {
        return '<span class="gallery-dot' + (i === idx ? ' active' : '') + '" data-goto="' + i + '"></span>';
      }).join('') + '</div>';
      nav += dots;
    }
    container.innerHTML = img + nav;
    // wire up gallery controls
    container.querySelectorAll('[data-goto]').forEach(function(btn) {
      btn.addEventListener('click', function(e) {
        e.stopPropagation();
        galleryState.current = parseInt(btn.getAttribute('data-goto'));
        updateGalleryPhoto();
      });
    });
  }

  function openDetail(id){
    var d = null;
    for (var i=0;i<DATA.length;i++){ if(DATA[i].id===id){ d=DATA[i]; break; } }
    if(!d) return;

    galleryState.photos = PHOTOS[d.id] || [];
    galleryState.current = 0;
    galleryState.listingId = id;
    updateGalleryPhoto();

    el('dm-title').textContent = d.title || '';
    el('dm-price').textContent = d.price_text || 'Fiyat sorunuz';
    var specs = [];
    if(d.m2) specs.push(d.m2+' m²');
    if(d.rooms) specs.push(d.rooms);
    if(d.location) specs.push(d.location);
    el('dm-code').textContent = d.code || d.id || '';
    el('dm-url').innerHTML = d.url ? '<a href="'+esc(d.url)+'" target="_blank" rel="noopener">Sahibinden.com linki</a>' : '';
    el('dm-specs').innerHTML = specs.map(function(s){return '<span class="chip">'+esc(s)+'</span>';}).join('');
    el('dm-meta').textContent = d.date || '';
    var office = [];
    if(d.seller_name) office.push('<b>'+esc(d.seller_name)+'</b>');
    if(d.seller_phone) office.push(esc(d.seller_phone));
    el('dm-office').innerHTML = office.join(' · ') || 'Trio Emlak · Danışmanlık';
    var m = el('detail-modal');
    m.classList.add('open');
    m.setAttribute('aria-hidden','false');
    document.body.style.overflow = 'hidden';
  }
  function closeDetail(){
    var m = el('detail-modal');
    m.classList.remove('open');
    m.setAttribute('aria-hidden','true');
    document.body.style.overflow = '';
  }
  el('grid').addEventListener('click', function(e){
    var card = e.target && e.target.closest ? e.target.closest('.card') : null;
    if(card && card.getAttribute('data-id')) openDetail(card.getAttribute('data-id'));
  });
  el('grid').addEventListener('keydown', function(e){
    if(e.key==='Enter' || e.key===' '){
      var card = e.target && e.target.closest ? e.target.closest('.card') : null;
      if(card && card.getAttribute('data-id')){ e.preventDefault(); openDetail(card.getAttribute('data-id')); }
    }
  });
  document.querySelectorAll('#detail-modal [data-close]').forEach(function(b){ b.addEventListener('click', closeDetail); });
  document.addEventListener('keydown', function(e){
    if(e.key==='Escape') closeDetail();
    if(galleryState.photos.length > 1) {
      if(e.key==='ArrowLeft') { galleryState.current = (galleryState.current - 1 + galleryState.photos.length) % galleryState.photos.length; updateGalleryPhoto(); }
      if(e.key==='ArrowRight') { galleryState.current = (galleryState.current + 1) % galleryState.photos.length; updateGalleryPhoto(); }
    }
  });

  initFilters();
  apply();
})();
</script>
</body>
</html>
